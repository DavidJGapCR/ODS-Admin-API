@adminapi_url=https://localhost/adminapi
@adminapi_client=adminapi_client2
@adminapi_secret=adminapi_SECRET_2025_rftyguhijkotgyhuijok
@tenant=tenant2

### Register a new client
POST {{adminapi_url}}/connect/register
Content-Type: application/x-www-form-urlencoded
Tenant: {{tenant}}

ClientId={{adminapi_client}}&ClientSecret={{adminapi_secret}}&DisplayName=Admin+API+{{adminapi_client}}

### Get a token
# @name tokenRequest
POST {{adminapi_url}}/connect/token
Content-Type: application/x-www-form-urlencoded
Authorization: basic {{adminapi_client}}:{{adminapi_secret}}
Tenant: {{tenant}}

grant_type=client_credentials&scope=edfi_admin_api/full_access

###
@token={{tokenRequest.response.body.access_token}}


### Create a DB instance (Minimal template)
# @name createOdsInstanceManageMinimal
POST {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

{
  "name": "My DB Instance",
  "databaseTemplate": "Minimal"
}

### Create a DB instance (Sample template)
# @name createOdsInstanceManageSample
POST {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

{
  "name": "My Sample DB Instance",
  "databaseTemplate": "Sample"
}

### Create a DB instance (Minimal template)
# @name createOdsInstanceManageMinimal
POST {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

{
  "name": "My Minimal DB Instance",
  "databaseTemplate": "Minimal"
}

### DELETE a DB instance (Minimal)
DELETE {{adminapi_url}}/v3{{createOdsInstanceManageMinimal.response.headers.location}}
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### DELETE a DB instance (Sample)
DELETE {{adminapi_url}}/v3{{createOdsInstanceManageSample.response.headers.location}}
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}


### Get all DB instances
GET {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### Get all ODS instances
GET {{adminapi_url}}/v3/datastores
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### Get all DB instances with pagination
GET {{adminapi_url}}/v3/datastores/manage?offset=0&limit=10
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### Get all DB instances filtered by name
GET {{adminapi_url}}/v3/datastores/manage?name=My DB Instance
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### Get DB instance by ID (Minimal)
GET {{createOdsInstanceManageMinimal.response.headers.location}}
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### Get DB instance by ID (Sample)
GET {{createOdsInstanceManageSample.response.headers.location}}
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### Get DB instance by ID - not found
GET {{adminapi_url}}/v3/datastores/manage/0
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

### Create DB instance - invalid (missing required fields)
POST {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

{
  "name": "",
  "databaseTemplate": ""
}

### Create DB instance - invalid (invalid name)
POST {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

{
  "name": "with-invalid.characters",
  "databaseTemplate": "Minimal"
}

### Create DB instance - invalid template
POST {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

{
  "name": "My DB Instance",
  "databaseTemplate": "InvalidTemplate"
}

### Create DB instance - invalid (name exceeds 46-character max)
# Name is capped at 46 characters so the generated database name
# (EdFi_Ods_{name}_{databaseTemplate}) can never exceed the 63-character
# portable limit. This name is 51 characters, so the request fails.
POST {{adminapi_url}}/v3/datastores/manage
Content-Type: application/json
Authorization: bearer {{token}}
Tenant: {{tenant}}

{
  "name": "This Instance Name Is Too Long And Must Be Rejected",
  "databaseTemplate": "Minimal"
}
